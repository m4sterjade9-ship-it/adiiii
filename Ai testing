
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My AI Assistant</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #10131c;
  color: white;
}

header {
  padding: 20px;
  background: #191e2b;
  border-bottom: 1px solid #303748;
  font-size: 20px;
  font-weight: bold;
}

main {
  max-width: 750px;
  margin: auto;
  padding: 20px;
}

#chat {
  height: 65vh;
  overflow-y: auto;
  padding: 10px;
}

.message {
  padding: 13px 16px;
  margin: 12px 0;
  border-radius: 14px;
  max-width: 85%;
  line-height: 1.5;
}

.user {
  background: #385ce8;
  margin-left: auto;
}

.bot {
  background: #252c3b;
  margin-right: auto;
}

.input-area {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

input {
  flex: 1;
  min-width: 0;
  padding: 15px;
  border-radius: 12px;
  border: 1px solid #444c60;
  background: #202637;
  color: white;
  font-size: 16px;
}

button {
  padding: 14px 20px;
  border: none;
  border-radius: 12px;
  background: #526ff5;
  color: white;
  font-weight: bold;
  cursor: pointer;
}
</style>
</head>

<body>

<header>✦ My AI Assistant</header>

<main>
  <div id="chat">
    <div class="message bot">
      Hello! I'm your personal assistant.
      What can I help you with today?
    </div>
  </div>

  <div class="input-area">
    <input id="question"
      placeholder="Ask me anything..."
      onkeydown="if(event.key==='Enter') sendMessage()">

    <button onclick="sendMessage()">Send</button>
  </div>
</main>

<script>
function sendMessage() {
  const input = document.getElementById("question");
  const chat = document.getElementById("chat");
  const question = input.value.trim();

  if (!question) return;

  const userMessage = document.createElement("div");
  userMessage.className = "message user";
  userMessage.textContent = question;
  chat.appendChild(userMessage);

  input.value = "";

  const botMessage = document.createElement("div");
  botMessage.className = "message bot";
  botMessage.textContent =
    "I'm your new AI assistant! My AI brain is not connected yet. We're building it together.";
  chat.appendChild(botMessage);

  chat.scrollTop = chat.scrollHeight;
}
</script>

</body>
</html>
